@using MudBarber.Web.Components.Shared
@using MudBarber.Web.Components.Shared.Toggles
@using MudBarber.Web.Providers
@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_darkMode" Theme="_theme" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <AppBarContent />
    </MudAppBar>

    <MudMainContent>
        @Body
        <DisplayModeToggle @bind-DarkMode="_darkMode" />
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private DisplayModeStateProvider? DisplayModeStateProvider { get; set; }

    private MudTheme _theme = new();
    private bool _darkMode;
    private bool _drawerOpen = false;

    protected override async Task OnInitializedAsync()
    {
        _darkMode = DisplayModeStateProvider?.DarkMode ?? true;
    }
}