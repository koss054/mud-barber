@using MudBarber.Web.Components.Shared.Buttons
@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_darkMode" Theme="_theme" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        MudBarber
    </MudAppBar>

    <MudDrawer Open="_drawerOpen" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true">
        <div style="display: flex; justify-content: center;">
            <MudToggleIconButton
                Toggled="_drawerOpen"
                ToggledChanged="ToggleDrawer"
                Icon="@Icons.Material.Outlined.ChevronRight"
                Color="@Color.Default"
                ToggledIcon="@Icons.Material.Outlined.ChevronLeft"
            />
        </div>
    </MudDrawer>

    <MudMainContent>
        @Body
        <DisplayModeToggle @bind-DarkMode="_darkMode" />
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = new();
    private bool _darkMode = true; 
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}