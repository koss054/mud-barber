@using MudBarber.Web.Components.Shared.Buttons
@using MudBarber.Web.Theme
@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_darkMode" Theme="_theme" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        MudBarber
    </MudAppBar>

    <MudDrawer Open="_drawerOpen" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true">
        <MudIcon Icon="@CustomIcons.Scissors" Color="Color.Primary" Size="Size.Large" />
        <DrawerToggle @bind-DrawerOpen="_drawerOpen" />
    </MudDrawer>

    <MudMainContent>
        @Body
        <DisplayModeToggle @bind-DarkMode="_darkMode" />
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = new();
    private bool _darkMode = true; 
    private bool _drawerOpen = false;
}