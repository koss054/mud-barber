<div class="stepper-step-wrapper">
    <MudPaper Class="@($"stepper-step-main {(IsCompleted ? "completed" : "")}")">
        <MudText Class="stepper-step-text">
            @StepTitle
        </MudText>
    </MudPaper>
</div>

@code {
    [Parameter]
    public string StepTitle { get; set; } = "#. Step Title";

    [Parameter]
    public bool IsCompleted { get; set; }
}