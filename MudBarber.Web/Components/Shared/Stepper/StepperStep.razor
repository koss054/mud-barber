<div class="stepper-step-wrapper">
    <MudPaper Class="@StepClass">
        <MudText Class="stepper-step-text">
            @StepTitle
        </MudText>
    </MudPaper>
</div>

@code {
    [Parameter]
    public string StepTitle { get; set; } = "#. Step Title";

    [Parameter]
    public StepState State { get; set; } = StepState.Locked;

    [Parameter]
    public bool IsActive { get; set; }

    private string StepClass =>
        $"stepper-step-main {State.ToString().ToLower()} {(IsActive ? "active" : "")}";
}
