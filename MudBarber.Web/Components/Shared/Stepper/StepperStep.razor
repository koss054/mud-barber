@using MudBarber.Web.Models

<div class="step-container @StateClass">
    <p class="step-index">@DisplayedIndex</p>
    <div class="step-label-container">
        <p class="step-label-top">@LabelTop</p>
        @if (!string.IsNullOrEmpty(LabelBottom))
        {
            <p class="step-label-bottom">@LabelBottom</p>
        }
    </div>
    @if (State == StepState.Completed)
    {
        <MudIconButton
            Icon="@Icons.Material.Filled.Edit"
            Color="Color.Primary"
            Size="Size.Small"
        />
    }
</div>

@code {
    [Parameter]
    public int Index { get; set; }

    // TODO: decide if assigning to new() is the right "step" (wink) here
    [Parameter]
    public StepModel Step { get; set; } = new();

    [Parameter]
    public StepState State { get; set; }

    private string StateClass => State.ToString().ToLowerInvariant();

    // TODO: decide where to keep constant string values
    private readonly string _activeLabelTop = "NOW";

    private string DisplayedIndex => State switch
    {
        StepState.Active or StepState.Unavailable => Index.ToString(),
        StepState.Completed => "✓",
        _ => Index.ToString()
    };

    private string LabelTop => State switch
    {
        StepState.Active => _activeLabelTop,
        StepState.Completed => Step.Title.ToUpper(),
        StepState.Unavailable => Step.Title,
        _ => Step.Title
    };

    private string LabelBottom => State switch
    {
        StepState.Active => Step.Title,
        StepState.Completed => Step.Summary() ?? string.Empty,
        StepState.Unavailable => string.Empty,
        _ => Step.Title
    };
}
