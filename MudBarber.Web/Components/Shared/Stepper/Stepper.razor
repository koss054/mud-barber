@using MudBarber.Web.Models

<StepperHeader
    Steps="Steps"
    ActiveIndex="_activeIndex"
    FurthestIndex="_furthestIndex"
/>

@Steps[_activeIndex].RenderFragment

<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
    <MudButton
        StartIcon="@Icons.Material.Filled.ArrowBack"
        OnClick="Back"
    >
        Back
    </MudButton>

    <MudButton 
        EndIcon="@Icons.Material.Filled.ArrowForward"
        OnClick="Next"
    >
        Next
    </MudButton>
</MudButtonGroup>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];

    private int _activeIndex;
    private int _furthestIndex;

    private bool CanAdvance =>
        _activeIndex < Steps.Count - 1 && Steps[_activeIndex].IsCompleted();

    private bool CanReturn =>
        _activeIndex > 0;

    private void Next()
    {
        if (CanAdvance)
        {
            _activeIndex++;
            _furthestIndex = Math.Max(_furthestIndex, _activeIndex);
        }
    }

    private void Back()
    {
        if (CanReturn)
        {
            _activeIndex--;
        }
    }
}