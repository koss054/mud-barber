@using MudBarber.Web.Models

<div class="stepper-container">
    <StepperHeader
        Steps="Steps"
        ActiveIndex="_activeIndex"
        FurthestIndex="_furthestIndex"
        OnStepEdit="GoToStep"
    />

    <div class="stepper-body">
        @for (var i = 0; i < Steps.Count; i++)
        {
            <div hidden="@(i != _activeIndex)">
                @Steps[i].RenderFragment
            </div>
        }
    </div>

    <div class="stepper-footer">
        <MudButton
            Variant="Variant.Text"
            Color="Color.Secondary"
            OnClick="Reset"
        >
            @* Using MudText to remove MubButton's auto ToUpper for the button text *@
            <MudText>
                Reset
            </MudText>
        </MudButton>
        <MudButton
            StartIcon="@Icons.Material.Filled.ArrowBack"
            Variant="Variant.Outlined"
            Disabled="!CanReturn"
            Color="Color.Inherit"
            OnClick="GoToPreviousStep"
        >
            <MudText>
                Back
            </MudText>
        </MudButton>

        <MudButton 
            EndIcon="@Icons.Material.Filled.ArrowForward"
            Variant="Variant.Outlined"
            Disabled="!CanAdvance"
            Color="Color.Primary"
            OnClick="GoToNextStep"
        >
            @if (_activeIndex + 1 < Steps.Count)
            {
                <MudText>
                    @Steps[_activeIndex + 1].EntryLabel
                </MudText>
            }
            else
            {
                <MudText>
                    Next
                </MudText>
            }
        </MudButton>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];

    [Parameter]
    public EventCallback OnReset { get; set; }

    private int _activeIndex = 0;
    private int _furthestIndex = 0;

    private bool CanAdvance =>
        _activeIndex < Steps.Count - 1 && Steps[_activeIndex].IsValid();

    private bool CanReturn =>
        _activeIndex > 0;

    private void GoToNextStep()
    {
        if (CanAdvance)
        {
            _activeIndex++;
            _furthestIndex = Math.Max(_furthestIndex, _activeIndex);
        }
    }

    private void GoToPreviousStep()
    {
        if (CanReturn)
        {
            _activeIndex--;
        }
    }

    private void GoToStep(int index)
    {
        _activeIndex = index;
    }

    private async Task Reset()
    {
        _activeIndex = 0;
        _furthestIndex = 0;
        await OnReset.InvokeAsync();
    }
}