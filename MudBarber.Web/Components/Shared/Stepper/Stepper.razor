@using MudBarber.Web.Models

<div class="stepper-container">
    <StepperHeader
        Steps="Steps"
        ActiveIndex="_activeIndex"
        FurthestIndex="_furthestIndex"
    />

    <div class="stepper-body">
        @Steps[_activeIndex].RenderFragment
    </div>

    <div class="stepper-footer">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
            <MudButton
                StartIcon="@Icons.Material.Filled.ArrowBack"
                OnClick="Back"
            >
                Back
            </MudButton>

            <MudButton 
                EndIcon="@Icons.Material.Filled.ArrowForward"
                OnClick="Next"
            >
                Next
            </MudButton>
        </MudButtonGroup>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];

    private int _activeIndex;
    private int _furthestIndex;

    private bool CanAdvance =>
        _activeIndex < Steps.Count - 1 && Steps[_activeIndex].IsValid();

    private bool CanReturn =>
        _activeIndex > 0;

    private void Next()
    {
        if (CanAdvance)
        {
            _activeIndex++;
            _furthestIndex = Math.Max(_furthestIndex, _activeIndex);
        }
    }

    private void Back()
    {
        if (CanReturn)
        {
            _activeIndex--;
        }
    }
}