@using MudBarber.Web.Models

<div class="header-container">
    @for (var i = 0; i < Steps.Count; i++)
    {
        <StepperStep
            Index="@(i + 1)"
            Step="@Steps[i]"
            State="@StateFor(i)"
        />
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];

    // TODO: decide if i'll ever need this
    [Parameter]
    public int ActiveIndex { get; set; }

    [Parameter]
    public int FurthestIndex { get; set; }

    private bool IsCompleted(int index) =>
        index < FurthestIndex && Steps[index].IsValid();

    private StepState StateFor(int index)
    {
        if (IsCompleted(index))
        {
            return StepState.Completed;
        }

        var isUnlocked = index == 0 || IsCompleted(index - 1);
        return isUnlocked ? StepState.Active : StepState.Unavailable;
    }
}
