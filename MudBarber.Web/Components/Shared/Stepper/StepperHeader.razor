@using MudBarber.Web.Models

<div class="header-container">
    @for (var i = 0; i < Steps.Count; i++)
    {
        <StepperStep
            Index="@(i + 1)"
            LabelTop="@Steps[i].Title"
            State="@StateFor(i)"
        />
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];

    [Parameter]
    public int ActiveIndex { get; set; }

    private StepState StateFor(int index) =>
        index < ActiveIndex ? StepState.Completed
        : index == ActiveIndex ? StepState.Active
        : StepState.Unavailable;
}
