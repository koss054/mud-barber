@using MudBarber.Web.Models
<div class="header-container">
    @for (var i = 1; i <= Steps.Count; i++)
    {
        <StepperStep 
            Index="@i"
            LabelTop="@Steps[i - 1].Title"
            State="StepState.Available"
        />
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];
}
