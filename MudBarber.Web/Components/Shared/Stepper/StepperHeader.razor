@using MudBarber.Web.Models

<div class="header-container">
    @for (var i = 0; i < Steps.Count; i++)
    {
        <StepperStep
            Index="@(i + 1)"
            Step="@Steps[i]"
            State="@StateFor(i)"
        />
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<StepModel> Steps { get; set; } = [];

    // TODO: decide if i'll ever need this
    [Parameter]
    public int ActiveIndex { get; set; }

    [Parameter]
    public int FurthestIndex { get; set; }

    private int CompletedSteps => Steps.Count(s => s.IsCompleted());

    private StepState StateFor(int index) => 
        Steps[index].IsCompleted() ? StepState.Completed
        : (index == 0)  || (index > 0 && Steps[index - 1].IsCompleted()) ? StepState.Active
        : StepState.Unavailable;
}
