@using MudBarber.Web.Models

<div class="datetime-step @(Locked ? "locked" : "")">
    <MudText Typo="Typo.h6" Class="mb-2">
        Choose date and time
    </MudText>
    <div class="date-grid">
        @foreach (var time in _times)
        {
            <MudPaper Class="@DateCardClass(time)" @onclick="() => Select(time)">
                <MudText Typo="Typo.body2">
                    @time.Date.DayOfWeek.ToString().Substring(0, 3)
                </MudText>
                <MudText Typo="Typo.subtitle1">
                    @time.Date.ToString("dd")
                </MudText>
            </MudPaper>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BookingModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    private readonly BookingDate[] _times =
    [
        new() { Date = DateOnly.FromDateTime(DateTime.Now), Available = false },
        new() { Date = DateOnly.FromDateTime(DateTime.Now.AddDays(1)), Available = true },
        new() { Date = DateOnly.FromDateTime(DateTime.Now.AddDays(2)), Available = true },
        new() { Date = DateOnly.FromDateTime(DateTime.Now.AddDays(3)), Available = true },
        new() { Date = DateOnly.FromDateTime(DateTime.Now.AddDays(4)), Available = true },
        new() { Date = DateOnly.FromDateTime(DateTime.Now.AddDays(5)), Available = true },
        new() { Date = DateOnly.FromDateTime(DateTime.Now.AddDays(6)), Available = true },
    ];

    private string DateCardClass(BookingDate date) =>
        $"date-card {(Model.Date == date? "selected" : "")}";

    private async Task Select(BookingDate option)
    {
        if (Locked)
        {
            return;
        }

        // TODO: adjust booking model + time step properties
        Model.Date = option;
        await OnChanged.InvokeAsync();
    }
}