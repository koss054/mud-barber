@using MudBarber.Web.Models

<div class="datetime-step @(Locked ? "locked" : "")">
    <MudText Typo="Typo.h6" Class="mb-2">
        Choose date and time
    </MudText>
    <div class="date-grid">
        @foreach (var date in Dates)
        {
            <MudPaper Class="@DateCardClass(date)" @onclick="() => SelectDate(date)">
                <MudText Typo="Typo.body2">
                    @date.DayOfWeek.ToString().Substring(0, 3)
                </MudText>
                <MudText Typo="Typo.subtitle1">
                    @date.ToString("dd")
                </MudText>
            </MudPaper>
        }
    </div>
    @if (Model.Date is not null)
    {
        <div class="time-grid">
            @foreach (var time in Times)
            {
                <MudPaper Class="@TimeCardClass(time)" @onclick="() => SelectTime(time)">
                    <MudText Typo="Typo.body2">
                        @time.ToString("HH\\:mm")
                    </MudText>
                </MudPaper>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public BookingModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    private static DateOnly StartDate =>
        DateOnly.FromDateTime(DateTime.Today);

    private static IEnumerable<DateOnly> Dates => 
        Enumerable.Range(0, 7).Select(StartDate.AddDays);

    private static IEnumerable<TimeOnly> Times => 
        Enumerable.Range(9, 8).Select(h => new TimeOnly(h, 0));
    
    private string DateCardClass(DateOnly date) =>
        $"date-card {(Model.Date == date? "selected" : "")}";

    private string TimeCardClass(TimeOnly time) =>
        $"time-card {(Model.Time == time ? "selected" : "")}";

    private async Task SelectDate(DateOnly option)
    {
        if (Locked)
        {
            return;
        }

        Model.Time = null;
        Model.Date = option;
        await OnChanged.InvokeAsync();
    }

    private async Task SelectTime(TimeOnly option)
    {
        if (Locked)
        {
            return;
        }

        if (Model.Date is null)
        {
            return;
        }

        Model.Time = option;
        await OnChanged.InvokeAsync();
    }
}