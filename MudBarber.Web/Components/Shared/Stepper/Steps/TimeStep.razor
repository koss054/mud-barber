@using MudBarber.Web.Models

<div class="datetime-step @(Locked ? "locked" : "")">
    <MudText Typo="Typo.h6" Class="mb-2">
        Choose date and time
    </MudText>
    <div class="date-grid">
        @foreach (var date in _dates)
        {
            <MudPaper Class="@DateCardClass(date)" @onclick="() => SelectDate(date)">
                <MudText Typo="Typo.body2">
                    @date.Date.DayOfWeek.ToString().Substring(0, 3)
                </MudText>
                <MudText Typo="Typo.subtitle1">
                    @date.Date.ToString("dd")
                </MudText>
            </MudPaper>
        }
    </div>
    @if (Model.Date is not null)
    {
        <div class="time-grid">
            @foreach (var time in Model.Date.Time)
            {
                <MudPaper @onclick="() => SelectTime(time)">
                    <MudText Typo="Typo.body2">
                        @time.Time.ToString("hh\\:mm")
                    </MudText>
                </MudPaper>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public BookingModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    private readonly static IEnumerable<BookingTime> _times =
    [
        new()
        {
            Time = new TimeOnly(9, 0),
            Available = true,
            Selected = false,
        },
        new()
        {
            Time = new TimeOnly(10, 0),
            Available = true,
            Selected = false,
        },
        new()
        {
            Time = new TimeOnly(11, 0),
            Available = true,
            Selected = false,
        },
        new()
        {
            Time = new TimeOnly(12, 0),
            Available = true,
            Selected = false,
        },
    ];

    private readonly BookingDate[] _dates =
    [
        new()
        {
            Date = DateOnly.FromDateTime(DateTime.Now),
            Available = false,
            Time = _times
        },
        new() {
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(1)),
            Available = true,
            Time = _times
        },
        new() {
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(2)),
            Available = true,
            Time = _times
        },
        new() {
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(3)),
            Available = true,
            Time = _times
        },
        new() {
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(4)),
            Available = true,
            Time = _times
        },
        new() {
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(5)),
            Available = true,
            Time = _times
        },
        new() {
            Date = DateOnly.FromDateTime(DateTime.Now.AddDays(6)),
            Available = true,
            Time = _times
        }
    ];

    private string DateCardClass(BookingDate date) =>
        $"date-card {(Model.Date == date? "selected" : "")}";

    private async Task SelectDate(BookingDate option)
    {
        // TODO: add Available check
        if (Locked)
        {
            return;
        }

        Model.Date = option;
        await OnChanged.InvokeAsync();
    }

    private async Task SelectTime(BookingTime option)
    {
        // TODO: add Available check
        if (Locked)
        {
            return;
        }

        if (Model.Date is null)
        {
            return;
        }

        // TODO: add error handling for cases where date has no times
        Model.Date.Time.Where(t => t == option).FirstOrDefault()!.Selected = true;
        await OnChanged.InvokeAsync();
    }
}