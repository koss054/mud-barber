@using MudBarber.Shared.BarberServices
@using MudBarber.Shared.Paging
@using MudBarber.Web.Models
@using MudBarber.Web.Services

@inject BarberServiceApiClient ServicesApi

<div class="service-step">
    <MudText Align="Align.Center" Typo="Typo.h6" Class="mb-3">
        Choose a service
    </MudText>
    <div class="service-grid">
        @* TODO: add if check for count - similar to BarberGrid.razor *@
        @foreach (var service in Services?.Items ?? Enumerable.Empty<BarberServiceDto>())
        {
            <MudPaper Class="@CardClass(service.Name)" @onclick="() => Select(service)">
                <MudText Typo="Typo.subtitle1">
                    @service.Name
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @service.EstimatedMinutes min · @service.Price lv
                </MudText>
            </MudPaper>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public BookingModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    // TODO: extract services grid to a separate component and move PageSize and IncludeRetired to it
    [Parameter]
    public int PageSize { get; set; } = 4;

    [Parameter]
    public bool IncludeRetired { get; set; } = false;

    private int _page = 1;
    private bool _busy;
    private bool _failed;

    // TODO: readonly struct for Price, maybe Money with Currency enum and Value decimal?
    [PersistentState]
    public PagedResult<BarberServiceDto>? Services { get; set; }

    private string CardClass(string name) =>
        $"service-card {(Model.Service?.Name == name ? "selected" : "")}";

    protected override async Task OnInitializedAsync()
    {
        if (Services is null)
        {
            await Load();
        }
        else
        {
            _page = Services.Page;
        }
    }

    private async Task Load()
    {
        _busy = true;
        _failed = false;

        try
        {
            Services = await ServicesApi.GetBarberServicesAsync(_page, PageSize, IncludeRetired);
            _page = Services.Page;
        }
        catch (Exception)
        {
            Services = null;
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Select(BarberServiceDto service)
    {
        Model.Service = service;
        await OnChanged.InvokeAsync();
    }
}
