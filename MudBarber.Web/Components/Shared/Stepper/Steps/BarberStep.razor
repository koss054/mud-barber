@using MudBarber.Shared.Barbers
@using MudBarber.Web.Components.Shared.Barbers
@using MudBarber.Web.Models

<div class="barber-step">
    <MudText Align="Align.Center" Typo="Typo.h6" Class="mb-3">
        Pick your barber
    </MudText>

    <BarberGrid
        SelectedBarber="Model.Barber"
        OnSelect="Select"
        PageSize="3"
    />
    
</div>

@code {
    [Parameter, EditorRequired]
    public BookingModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task Select(BarberDto barber)
    {   
        Model.Barber = barber;
        await OnChanged.InvokeAsync();
    }
}
