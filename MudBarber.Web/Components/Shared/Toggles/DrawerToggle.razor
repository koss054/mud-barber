<div id="drawer-toggle-container">
    <div id="drawer-toggle">
        <MudToggleIconButton
            Toggled="DrawerOpen"
            ToggledChanged="ToggleDrawerOpen"
            Icon="@Icons.Material.Outlined.ChevronRight"
            Color="@Color.Default"
            ToggledIcon="@Icons.Material.Outlined.ChevronLeft"
            title="@(DrawerOpen ? "Close Drawer" : "Open Drawer")"
        />
    </div>
</div>

@code {
    [Parameter]
    public bool DrawerOpen { get; set; } = false;

    [Parameter]
    public EventCallback<bool> DrawerOpenChanged { get; set; }

    private async Task ToggleDrawerOpen(bool value)
    {
        DrawerOpen = value;
        await DrawerOpenChanged.InvokeAsync(value);
    }
}
