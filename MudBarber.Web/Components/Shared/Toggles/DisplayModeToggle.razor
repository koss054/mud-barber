@using MudBarber.Web.Providers;

<div id="toggle-corner">
    <MudToggleIconButton
        Toggled="DarkMode"
        ToggledChanged="ToggleDarkMode"
        Icon="@Icons.Material.Outlined.LightMode"
        Color="@Color.Default"
        ToggledIcon="@Icons.Material.Outlined.DarkMode"
        ToggledColor="@Color.Default"
        title="@(DarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
    />
</div>

@code {
    [CascadingParameter]
    private DisplayModeStateProvider? DisplayModeStateProvider { get; set; }

    [Parameter]
    public bool DarkMode { get; set; }

    [Parameter]
    public EventCallback<bool> DarkModeChanged { get; set; }

    private async Task ToggleDarkMode(bool value)
    {
        if (DisplayModeStateProvider is not null)
        {
            await DisplayModeStateProvider.ToggleDarkMode();
            DarkMode = DisplayModeStateProvider.DarkMode;
            Console.WriteLine($"Is state provider dark mode: {DisplayModeStateProvider.DarkMode}");
        }

        DarkMode = value;
        await DarkModeChanged.InvokeAsync(value);
    }
}