@using MudBarber.Shared.Barbers

<div class="barber-card-host">
    <MudPaper Class="@CardClass" @onclick="() => OnSelect.InvokeAsync(Barber.Id)">
        <MudAvatar Color="Color.Primary">
            @Initial
        </MudAvatar>
        <MudText Typo="Typo.subtitle1">
            @DisplayName
        </MudText>
        @if (IsRetired)
        {
            <MudChip
                T="string"
                Size="Size.Small"
                Color="Color.Default"
                Variant="Variant.Outlined"
                Class="barber-card-chip"
            >
                Retired
            </MudChip>
        }
        else if (Barber.Rating > 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary barber-rating">
                <MudIcon
                    Icon="@Icons.Material.Filled.Star"
                    Color="Color.Warning"
                    Class="barber-rating-icon"
                    Size="Size.Small"
                />
                @Barber.Rating.ToString("F1")
            </MudText>
        }
        else
        {
            <MudChip
                T="string"
                Size="Size.Small"
                Color="Color.Info"
                Variant="Variant.Outlined"
                Class="barber-card-chip"
            >
                New
            </MudChip>
        }
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired]
    public BarberDto Barber { get; set; } = default!;

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelect { get; set; }

    private bool IsRetired => Barber.RetiredAt != null;

    private string CardClass =>
        $"barber-card {(Selected ? "selected" : "")} {(IsRetired ? "retired" : "")}";

    private string DisplayName => $"{Barber.FirstName} {Barber.LastName}".Trim();

    private string Initial =>
        string.IsNullOrWhiteSpace(Barber.FirstName)
            ? "?"
            : Barber.FirstName.Trim()[0].ToString().ToUpperInvariant();
}
