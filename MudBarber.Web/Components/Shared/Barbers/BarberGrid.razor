@using MudBarber.Shared.Barbers
@using MudBarber.Shared.Paging
@using MudBarber.Web.Services

@inject BarberApiClient BarberApi

@if (_busy && Barbers is null)
{
    <div class="barber-grid" style="@GridStyle">
        @foreach (var _ in Enumerable.Range(0, PageSize))
        {
            <MudSkeleton
                SkeletonType="SkeletonType.Rectangle"
                Height="118px"
                Class="barber-skeleton"
            />
        }
    </div>
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error" Class="my-2">
        Couldn't load barbers.
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Load">
            Retry
        </MudButton>
    </MudAlert>
}
else if (Barbers is null || Barbers.Items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="my-2">
        No barbers are available right now.
    </MudAlert>
}
else
{
    <div class="barber-grid" style="@GridStyle">
        @foreach (var barber in Barbers.Items)
        {
            <BarberCard
                @key="barber.Id"
                Barber="barber"
                Selected="@(SelectedId == barber.Id)"
                OnSelect="OnSelect"
            />
        }
    </div>

    @if (Barbers.TotalPages > 1)
    {
        <div class="barber-pager">
            <MudIconButton
                Icon="@Icons.Material.Filled.ChevronLeft"
                Size="Size.Small"
                Disabled="@(_busy || !Barbers.HasPrevious)"
                OnClick="@(() => GoToPage(Barbers.Page - 1))"
            />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @Barbers.Page / @Barbers.TotalPages
            </MudText>
            <MudIconButton
                Icon="@Icons.Material.Filled.ChevronRight"
                Size="Size.Small"
                Disabled="@(_busy || !Barbers.HasNext)"
                OnClick="@(() => GoToPage(Barbers.Page + 1))"
            />
        </div>
    }
}

@code {
    [Parameter]
    public Guid? SelectedId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelect { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 12;

    [Parameter]
    public bool IncludeRetired { get; set; }

    [Parameter]
    public int Columns { get; set; } = 3;

    private string GridStyle => $"--barber-grid-columns: {Columns};";

    [PersistentState]
    public PagedResult<BarberDto>? Barbers { get; set; }

    private int _page = 1;
    private bool _busy;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        if (Barbers is null)
        {
            await Load();
        }
        else
        {
            _page = Barbers.Page;
        }
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await Load();
    }

    private async Task Load()
    {
        _busy = true;
        _failed = false;

        try
        {
            Barbers = await BarberApi.GetBarbersAsync(_page, PageSize, IncludeRetired);
            _page = Barbers.Page;
        }
        catch (Exception)
        {
            Barbers = null;
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
