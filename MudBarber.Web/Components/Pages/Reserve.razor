@page "/reserve"

@using MudBarber.Web.Components.Shared.Stepper
@using MudBarber.Web.Components.Shared.Stepper.Steps
@using MudBarber.Web.Models

<Stepper 
    Steps="_steps"
/>

@code {
    private readonly BookingModel _model = new();

    private IReadOnlyList<StepModel> _steps = [];

    protected override void OnInitialized()
    {
        _steps = new List<StepModel>
        {
            new StepModel
            {
                Title = "Service",
                Summary = () => _model.Service?.Name,
                IsCompleted = () => IsStepCompleted(Step.Service),
                RenderFragment = @<ServiceStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new StepModel
            {
                Title = "Barber",
                Summary = () => _model.Barber?.FullName,
                IsCompleted = () => IsStepCompleted(Step.Barber),
                RenderFragment = @<BarberStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new StepModel
            {
                Title = "Time",
                Summary = () => $"{_model.Date?.ToString("ddd dd MMM")}, {_model.Time?.ToString("HH:mm")}",
                IsCompleted = () => IsStepCompleted(Step.Time),
                RenderFragment = @<TimeStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new StepModel
            {
                Title = "Confirm",
                IsCompleted = () => IsStepCompleted(Step.Confirm),
                RenderFragment = @<ConfirmStep
                    Model="_model"
                />
            }
        };
    }

    private enum Step
    {
        Service,
        Barber,
        Time,
        Confirm
    }

    private bool IsStepCompleted(Step step) => step switch
    {
        Step.Service => _model.Service is not null,
        Step.Barber => _model.Barber is not null,
        Step.Time => _model.Date is not null && _model.Time is not null,
        Step.Confirm => !string.IsNullOrEmpty(_model.Phone),
        _ => false
    };
}
