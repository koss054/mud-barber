@page "/reserve"
@using MudBarber.Web.Components.Shared.Stepper
@using MudBarber.Web.Components.Shared.Stepper.Steps
@using MudBarber.Web.Models

<div class="stepper-row">
    @for (var i = 0; i < _titles.Length; i++)
    {
        var index = i;
        <StepperStep
            StepTitle="@_titles[index]"
            State="StepStateFor(index)"
            IsActive="_viewStep == index"
            OnClick="(Action)(() => _viewStep = index)"
        />

        @if (index < _titles.Length - 1)
        {
            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
        }
    }
</div>

<MudDivider Class="my-4" />

@switch (_viewStep)
{
    case 0:
        <ServiceStep Model="_model" OnChanged="StateHasChanged" />
        break;
    default:
        <MudText>Step "@_titles[_viewStep]" - coming soon.</MudText>
        break;
}

@code {
    private readonly BookingModel _model = new();

    private int _viewStep;

    private readonly string[] _titles =
    [
        "1. Service", "2. Barber", "3. Time", "4. Confirm"
    ];

    private StepState StepStateFor(int index)
    {
        if (IsStepComplete(index))
        {
            return StepState.Completed;
        }

        return index <= FirstIncomplete
            ? StepState.Available
            : StepState.Locked;
    }

    private bool IsStepComplete(int index) => index switch
    {
        0 => !string.IsNullOrEmpty(_model.Service),
        1 => !string.IsNullOrEmpty(_model.Barber),
        2 => _model.Date is not null && !string.IsNullOrEmpty(_model.Time),
        3 => !string.IsNullOrEmpty(_model.Phone),
        _ => false
    };

    private int FirstIncomplete
    {
        get
        {
            for (var i = 0; i < _titles.Length; i++)
            {
                if (!IsStepComplete(i))
                {
                    return i;
                }
            }

            return _titles.Length;
        }
    }
}
