@page "/reserve"

@using MudBarber.Web.Components.Shared
@* TODO: decide if chaning the stepper folder structure is needed - replaced the custom stepper with custom flow form *@
@using MudBarber.Web.Components.Shared.Stepper
@using MudBarber.Web.Components.Shared.Stepper.Steps
@using MudBarber.Web.Models
@using MudBarber.Web.Theme

<FlowForm 
    FlowIcon="@ImportedIcons.Scissors"
    FlowSteps="_flowSteps"
/>

<Stepper 
    Steps="_flowSteps"
/>

@code {
    private readonly BookingModel _model = new();

    private IReadOnlyList<StepModel> _flowSteps = [];

    protected override void OnInitialized()
    {
        _flowSteps = new List<StepModel>
        {
            new StepModel
            {
                Title = "Service",
                Summary = () => _model.Service?.Name,
                IsComplete = () => IsStepComplete(Step.Service),
                RenderFragment = @<ServiceStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new StepModel
            {
                Title = "Barber",
                Summary = () => _model.Barber?.FullName,
                IsComplete = () => IsStepComplete(Step.Barber),
                RenderFragment = @<BarberStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new StepModel
            {
                Title = "Time",
                Summary = () => $"{_model.Date?.ToString("ddd dd MMM")}, {_model.Time?.ToString("HH:mm")}",
                IsComplete = () => IsStepComplete(Step.Time),
                RenderFragment = @<TimeStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new StepModel
            {
                Title = "Confirm",
                IsComplete = () => IsStepComplete(Step.Confirm),
                RenderFragment = @<ConfirmStep
                    Model="_model"
                />
            }
        };
    }

    private enum Step
    {
        Service,
        Barber,
        Time,
        Confirm
    }

    private bool IsStepComplete(Step step) => step switch
    {
        Step.Service => _model.Service is not null,
        Step.Barber => _model.Barber is not null,
        Step.Time => _model.Date is not null && _model.Time is not null,
        Step.Confirm => !string.IsNullOrEmpty(_model.Phone),
        _ => false
    };
}
