@page "/reserve"

@using MudBarber.Web.Components.Shared
@using MudBarber.Web.Components.Shared.Stepper
@using MudBarber.Web.Components.Shared.Stepper.Steps
@using MudBarber.Web.Models
@using MudBarber.Web.Theme

<FlowForm 
    FlowIcon="@ImportedIcons.Scissors"
    FlowSteps="_flowSteps"
/>

@code {
    private readonly BookingModel _model = new();

    private IReadOnlyList<FlowStepModel> _flowSteps = [];

    protected override void OnInitialized()
    {
        _flowSteps = new List<FlowStepModel>
        {
            new FlowStepModel
            {
                Title = "1. Service",
                RenderFragment = @<ServiceStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                />
            },
            new FlowStepModel
            {
                Title = "2. Barber",
                RenderFragment = @<BarberStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                    Locked="!IsStepComplete(Step.Service)"
                />
            },
            new FlowStepModel
            {
                Title = "3. Time",
                RenderFragment = @<TimeStep
                    Model="_model"
                    OnChanged="StateHasChanged"
                    Locked="!IsStepComplete(Step.Barber)"
                />
            },
            new FlowStepModel
            {
                Title = "4. Confirm",
                RenderFragment = @<MudText>Confirm step goes here.</MudText>
            }
        };
    }

    private readonly string[] _titles =
    [
        "1. Service", "2. Barber", "3. Time", "4. Confirm"
    ];

    private enum Step
    {
        Service,
        Barber,
        Time,
        Confirm
    }

    private StepState StepStateFor(int index)
    {
        if (IsStepComplete((Step)index))
        {
            return StepState.Completed;
        }

        return index <= FirstIncomplete
            ? StepState.Available
            : StepState.Locked;
    }

    private bool IsStepComplete(Step step) => step switch
    {
        Step.Service => !string.IsNullOrEmpty(_model.Service),
        Step.Barber => _model.BarberId is not null,
        Step.Time => _model.Date is not null && _model.Time is not null,
        Step.Confirm => !string.IsNullOrEmpty(_model.Phone),
        _ => false
    };

    private int FirstIncomplete
    {
        get
        {
            for (var i = 0; i < _titles.Length; i++)
            {
                if (!IsStepComplete((Step)i))
                {
                    return i;
                }
            }

            return _titles.Length;
        }
    }
}
