@page "/barbers"

@using MudBarber.Shared.Barbers
@using MudBarber.Web.Components.Shared.Barbers

<div class="barbers-container">
    <BarberGrid
        Class="barbers-grid"
        AlwaysShowPager="true"
        SelectedId="_selectedBarber?.Id"
        OnSelect="Select"
        Columns=3
    />
    <MudPaper Class="barbers-form">
        <h1>Test</h1>
    </MudPaper>
</div>

@code {
    private BarberDto? _selectedBarber;

    private void Select(BarberDto barber)
    {
        _selectedBarber = barber;
    }
}