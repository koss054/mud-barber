@page "/barbers"

@using MudBarber.Web.Components.Shared.Barbers

<div class="barbers-container">
    <BarberGrid
        Class="barbers-grid"
        AlwaysShowPager="true"
        SelectedId="_selectedId"
        OnSelect="Select"
        Columns=3
    />
    <MudPaper Class="barbers-form">

        <h1>Test</h1>
    </MudPaper>
</div>

@code {
    private Guid? _selectedId;

    private void Select(Guid id)
    {
        _selectedId = id;
    }
}