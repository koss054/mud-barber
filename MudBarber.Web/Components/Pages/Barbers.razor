@page "/barbers"

@using MudBarber.Shared.Barbers
@using MudBarber.Web.Components.Shared.Barbers
@using MudBarber.Web.Services

@inject BarberApiClient BarberApi

<div class="barbers-container">

    <BarberGrid
        Class="barbers-grid"
        IncludeRetired="true"
        AlwaysShowPager="true"
        SelectedId="_selectedBarber?.Id"
        OnSelect="Select"
        Columns=3
    />

    <MudPaper Class="barbers-form">

        <MudAvatar Class="barbers-avatar" Color="Color.Primary"> 
            @BarberInitial
        </MudAvatar>

        <MudText Class="barbers-name" Typo="Typo.h2">
            @BarberFullName
        </MudText>

        @if (_selectedBarber is not null)
        {
            @if (_selectedBarber.RetiredAt is null)
            {
                <MudButton
                    Class="barbers-form-button"
                    Variant="Variant.Outlined"
                    Color="Color.Error"
                    @onclick="() => RetireBarber(_selectedBarber.Id)"
                >
                    Retire Barber
                </MudButton>
            }
            else
            {
                <MudButton
                    Class="barbers-form-button"
                    Variant="Variant.Outlined"
                    Color="Color.Success"
                    @onclick="() => RestoreBarber(_selectedBarber.Id)"
                >
                    Restore Barber
                </MudButton>
            }

            @if (BarberRating > 0)
            {
                <MudRating
                    Class="mt-2"
                    ReadOnly="true"
                    SelectedValue="@BarberRating"
                />
            }

            @if (BarberRating == 0) 
            {
                <MudChip
                    T="string"
                    Class="mt-2 barbers-form-chip"
                    Size="Size.Large"
                    Color="Color.Info"
                    Variant="Variant.Outlined"
                >
                    New
                </MudChip>
            }
            else if (_selectedBarber.RetiredAt is null)
            {
                <MudChip
                    T="string"
                    Class="mt-2 barbers-form-chip"
                    Size="Size.Large"
                    Color="Color.Success"
                    Variant="Variant.Outlined"
                >
                    Active
                </MudChip>
            }
            else
            {
                <MudChip
                    T="string"
                    Class="mt-2 barbers-form-chip"
                    Size="Size.Large"
                    Color="Color.Error"
                    Variant="Variant.Outlined"
                >
                    Retired
                </MudChip>
            }
        }

    </MudPaper>

</div>

@code {
    private BarberDto? _selectedBarber;

    private void Select(BarberDto barber)
    {
        _selectedBarber = barber;
    }

    private async Task<bool> RetireBarber(Guid barberId)
    {
        if (_selectedBarber is null)
        {
            return false;
        }

        var result = await BarberApi.RetireBarberAsync(barberId);
        return result;
    }

    // TODO: update this when the BarberApiClient.RestoreBarberAsync's TODO is done.
    private async Task<bool> RestoreBarber(Guid barberId)
    {
        if (_selectedBarber is null)
        {
            return false;
        }

        var result = await BarberApi.RestoreBarberAsync(barberId);
        return result is not null;
    }

    // TODO: decide if these barber specific values should live here or somewhere else.
    private string BarberFullName =>
        _selectedBarber is null
            ? ""
            : $"{_selectedBarber.FirstName} {_selectedBarber.LastName}";

    private int BarberRating =>
        _selectedBarber is null
            ? 0
            : Decimal.ToInt32(_selectedBarber.Rating);

    // TODO: DRY this (repeated in BarberCard.razor)
    private string BarberInitial => 
        string.IsNullOrWhiteSpace(_selectedBarber?.FirstName)
            ? "?"
            : _selectedBarber.FirstName.Trim()[0].ToString().ToUpperInvariant();
}